# Copy this file to .env and keep all real values local.

EQRA_DB_PATH=app/config/IPCam.db
EQRA_FACE_AI_TOLERANCE=0.7
EQRA_FACE_AI_CPUS=1
EQRA_FACE_AI_DETECT_TIME=0.75

# Optional Arduino or ESP8266 serial connection.
EQRA_SERIAL_PORT=
EQRA_SERIAL_BAUD_RATE=9600
EQRA_RELAY_AUTHORIZED_IDS=

# Optional camera fallback settings. Camera records can also be entered in the UI.
EQRA_CAMERA_IP=
EQRA_CAMERA_PORT=554
EQRA_CAMERA_USERNAME=
EQRA_CAMERA_PASSWORD=

# Optional legacy MySQL backend. SQLite is used by default.
EQRA_MYSQL_HOST=127.0.0.1
EQRA_MYSQL_PORT=3306
EQRA_MYSQL_USER=IPCam
EQRA_MYSQL_PASSWORD=
EQRA_MYSQL_DATABASE=IPCam
EQRA_SQL_PAGE_SIZE=25
